<script>
(function(){
  var cv=document.getElementById('bgfx');if(!cv||!cv.getContext)return;
  var ctx=cv.getContext('2d'),mq=function(q){return window.matchMedia&&matchMedia(q).matches;};
  var reduce=mq('(prefers-reduced-motion: reduce)'),dark=mq('(prefers-color-scheme: dark)');
  var BALL=[[50,57,214],[168,85,247],[240,160,30],[16,170,125]],BALLD=[[130,138,255],[196,140,255],[255,196,80],[70,215,165]];
  var W=0,H=0,dpr=1,items=[],stars=[],raf=0,last=0,T=0;
  function rnd(a,b){return a+Math.random()*(b-a);}
  function size(){
    dpr=Math.min(window.devicePixelRatio||1,2);W=innerWidth;H=innerHeight;
    cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr);cv.style.width=W+'px';cv.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  function mk(init){
    var ball=Math.random()<0.34;
    return {x:rnd(0,W),y:init?rnd(0,H):H+rnd(40,120),v:rnd(10,30),ph:rnd(0,6.28),sw:rnd(8,22),
      d:Math.floor(rnd(0,10)),ball:ball,r:ball?rnd(15,30):0,s:rnd(16,46),c:Math.floor(rnd(0,4)),a:rnd(0.09,0.2),rot:rnd(-.5,.5)};
  }
  function build(){
    var n=Math.round(Math.max(16,Math.min(34,W/15)));items=[];for(var i=0;i<n;i++)items.push(mk(true));
    stars=[];for(var j=0;j<16;j++)stars.push({x:rnd(0,W),y:rnd(0,H),p:rnd(0,6.28),sp:rnd(.6,1.6),s:rnd(2,4.5)});
  }
  function draw(){
    ctx.clearRect(0,0,W,H);
    var pal=dark?BALLD:BALL,tx=dark?[190,196,255]:[50,57,214],i,it,x,c,g;
    for(i=0;i<stars.length;i++){
      var st=stars[i],tw=0.5+0.5*Math.sin(T*0.001*st.sp+st.p),al=0.08+0.32*tw;
      ctx.strokeStyle='rgba('+tx[0]+','+tx[1]+','+tx[2]+','+al.toFixed(3)+')';ctx.lineWidth=1.2;
      ctx.beginPath();ctx.moveTo(st.x-st.s,st.y);ctx.lineTo(st.x+st.s,st.y);ctx.moveTo(st.x,st.y-st.s);ctx.lineTo(st.x,st.y+st.s);ctx.stroke();
    }
    ctx.textAlign='center';ctx.textBaseline='middle';
    for(i=0;i<items.length;i++){
      it=items[i];x=it.x+Math.sin(T*0.0006+it.ph)*it.sw;
      if(it.ball){
        c=pal[it.c];
        g=ctx.createRadialGradient(x-it.r*.35,it.y-it.r*.38,it.r*.1,x,it.y,it.r);
        g.addColorStop(0,'rgba(255,255,255,'+(it.a*1.8).toFixed(3)+')');
        g.addColorStop(.35,'rgba('+c[0]+','+c[1]+','+c[2]+','+(it.a*1.6).toFixed(3)+')');
        g.addColorStop(1,'rgba('+c[0]+','+c[1]+','+c[2]+','+(it.a*.9).toFixed(3)+')');
        ctx.fillStyle=g;ctx.beginPath();ctx.arc(x,it.y,it.r,0,6.2832);ctx.fill();
        ctx.fillStyle='rgba(255,255,255,'+Math.min(.55,it.a*2.6).toFixed(3)+')';
        ctx.font='800 '+Math.round(it.r*1.05)+'px Georgia,serif';ctx.fillText(it.d,x,it.y+1);
      }else{
        ctx.save();ctx.translate(x,it.y);ctx.rotate(it.rot);
        ctx.fillStyle='rgba('+tx[0]+','+tx[1]+','+tx[2]+','+it.a.toFixed(3)+')';
        ctx.font='700 '+Math.round(it.s)+'px Georgia,serif';ctx.fillText(it.d,0,0);ctx.restore();
      }
    }
  }
  function frame(t){
    var dt=Math.min(0.05,(t-last)/1000||0.016);last=t;T=t;
    for(var i=0;i<items.length;i++){var it=items[i];it.y-=it.v*dt;it.rot+=dt*0.04;if(it.y<-90){items[i]=mk(false);}}
    draw();raf=requestAnimationFrame(frame);
  }
  function start(){if(reduce||raf)return;last=performance.now();raf=requestAnimationFrame(frame);}
  function stop(){if(raf){cancelAnimationFrame(raf);raf=0;}}
  size();build();draw();start();
  document.addEventListener('visibilitychange',function(){document.hidden?stop():start();});
  var rt=0;addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(function(){size();build();draw();},180);});
  try{matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(e){dark=e.matches;draw();});}catch(e){}
})();
</script>
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";
import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";
import { getFirestore, collection, addDoc, deleteDoc, doc, writeBatch, query, orderBy, limit, onSnapshot, serverTimestamp, where, Timestamp, getDoc, getDocs } from "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";

const ADMIN_EMAIL = "alifavif@gmail.com";
const firebaseConfig = {
  apiKey: "AIzaSyBgSWlU9xkG-A3seitPy9zI_743aeLIEFo",
  authDomain: "komunikasi-e593d.firebaseapp.com",
  projectId: "komunikasi-e593d",
  storageBucket: "komunikasi-e593d.firebasestorage.app",
  messagingSenderId: "509726825544",
  appId: "1:509726825544:web:02c5e6b9100ea7954b4c7d"
};

const $ = id => document.getElementById(id);
const bulan = ["Januari","Februari","Maret","April","Mei","Juni","Juli","Agustus","September","Oktober","November","Desember"];
const esc = s => String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const tgl = t => { if (!t) return "baru saja"; const d = t.toDate(); return `${d.getDate()} ${bulan[d.getMonth()]} ${d.getFullYear()}`; };

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
let user = null, posts = [], loaded = false, loadErr = "";

const isAdmin = () => user && user.email && user.email.toLowerCase() === ADMIN_EMAIL;
const canDelete = p => user && (isAdmin() || p.uid === user.uid);

/* baris "Label: isi" ditampilkan rapi; baris biasa tetap teks */
const link = t => esc(t).replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener">$1</a>');
const SITE_LINK = "https://scenangka.github.io/MASTER/";
const norm = t => String(t).split("https://scenangka.github.io/Scenangka/").join(SITE_LINK).replace(/https:\/\/alifavif-cmd\.github\.io\/-WONGBAGUS-PREDICTION-\/?/g, SITE_LINK);
const shareText = p => { let t = norm(p.isi).trim(); if (!t.includes(SITE_LINK)) t += "\n\n🔗 " + SITE_LINK; return t; };
const baris = l => {
  if (/https?:\/\//i.test(l)) return `<p class="ln t">${link(l)}</p>`;
  const m = l.match(/^\s*([^:：\/]{1,16}?)\s*[:：]\s*(\S.*)$/);
  return m ? `<p class="ln"><span class="k">${esc(m[1])}</span><span class="v">${link(m[2])}</span></p>` : `<p class="ln t">${link(l)}</p>`;
};

/* ===== komentar: subkoleksi posts/{id}/comments ===== */
let cmUnsub = null, cmPid = "", cmList = [], cmErr = "";
const stopCm = () => { if (cmUnsub) { cmUnsub(); cmUnsub = null; } cmPid = ""; cmList = []; cmErr = ""; };
function drawCm(){
  const el = $("cml"); if (!el) return;
  if (cmErr) { el.innerHTML = `<p class="cmnote">${esc(cmErr)}</p>`; return; }
  el.innerHTML = cmList.length
    ? cmList.map(c => `<div class="cm"><span class="meta">${esc(c.nama || "Anonim")} · ${tgl(c.createdAt)}</span><p>${esc(c.isi || "")}</p>${isAdmin() ? `<button class="x" data-c="${esc(c.id)}">Hapus komentar</button>` : ""}</div>`).join("")
    : `<p class="cmnote">Belum ada komentar.</p>`;
}
function startCm(pid){
  if (cmPid === pid) { drawCm(); return; }
  stopCm(); cmPid = pid;
  cmUnsub = onSnapshot(query(collection(db, "posts", pid, "comments"), orderBy("createdAt", "asc"), limit(200)),
    snap => { cmList = snap.docs.map(d => ({ id: d.id, ...d.data() })); cmErr = ""; drawCm(); },
    err => { cmErr = "Komentar belum bisa dimuat: " + err.code; drawCm(); });
}

/* ===== kelompok pasaran + filter hari + hapus massal ===== */
const HARI = ["Min","Sen","Sel","Rab","Kam","Jum","Sab"];
let fDay = 0, fQ = "";   // fDay = berapa hari ke belakang (0 = hari ini)
let dayLoading = true, unDay = null, extra = null, extraTry = "";
const openG = new Set();
const sameDay = (d, o) => d.getFullYear() === o.getFullYear() && d.getMonth() === o.getMonth() && d.getDate() === o.getDate();
const pasaranKey = j => {
  let t = String(j || "Tanpa judul").trim();
  t = t.replace(/^Rekap\s*[·•]\s*/i, "");
  t = t.replace(/[\u{1F1E6}-\u{1F1FF}]{2}/gu, "").replace(/\s+/g, " ").trim();
  t = t.split(/\s*[·•]\s*/)[0].trim();
  return t || String(j || "Tanpa judul").trim();
};
const gbrSrc = p => (typeof p.gambar === "string" && p.gambar.startsWith("data:image/")) ? p.gambar : "";
function lolos(p){
  return !fQ || ((p.judul || "") + " " + (p.nama || "")).toLowerCase().includes(fQ);
}
function watchDay(off){
  if (unDay) { unDay(); unDay = null; }
  dayLoading = true; posts = []; renderList();
  const st = new Date(); st.setHours(0, 0, 0, 0); st.setDate(st.getDate() - off);
  const en = new Date(st); en.setDate(en.getDate() + 1);
  unDay = onSnapshot(query(collection(db, "posts"), where("createdAt", ">=", Timestamp.fromDate(st)), where("createdAt", "<", Timestamp.fromDate(en)), orderBy("createdAt", "desc"), limit(1000)),
    snap => { posts = snap.docs.map(d => ({ id: d.id, ...d.data() })); loaded = true; loadErr = ""; dayLoading = false; render(); },
    err => { loadErr = "Gagal memuat tulisan: " + err.code; dayLoading = false; render(); });
}
function renderList(){
  const el = $("plist"); if (!el) return;
  if (dayLoading) { el.innerHTML = `<p class="empty">Memuat…</p>`; return; }
  const shown = posts.filter(lolos);
  const g = {};
  shown.forEach(p => { const k = pasaranKey(p.judul); (g[k] = g[k] || []).push(p); });
  const keys = Object.keys(g).sort((a, b) => a.localeCompare(b, "id"));
  const auto = keys.length <= 3;
  el.innerHTML = (shown.length ? `<p class="hasil">${shown.length} postingan · ${keys.length} pasaran</p>` : "") + (keys.length
    ? keys.map(k => `<details class="grp" data-g="${esc(k)}"${(openG.has(k) || auto) ? " open" : ""}><summary><span>${esc(k)}</span><small>${g[k].length} post</small></summary>${g[k].map(p => `<a class="card" href="#${encodeURIComponent(p.id)}"><span class="meta">${esc(p.nama)} · ${tgl(p.createdAt)}</span>${pasaranKey(p.judul) !== (p.judul || "").trim() ? `<b class="sub">${esc(p.judul)}</b>` : ""}${gbrSrc(p) ? `<img class="gb" loading="lazy" alt="${esc(p.judul)}" src="${gbrSrc(p)}">` : ""}<p class="pv">${esc(String(p.isi || "").slice(0, 400))}</p></a>`).join("")}</details>`).join("")
    : `<p class="empty">${posts.length ? "Tidak ada postingan yang cocok." : "Belum ada postingan di hari ini. Pilih hari lain di atas."}</p>`);
  el.querySelectorAll("details.grp").forEach(d => d.addEventListener("toggle", () => { d.open ? openG.add(d.dataset.g) : openG.delete(d.dataset.g); }));
  const a = $("hps"), b = $("hpa");
  if (a) { a.textContent = `Hapus yang tampil (${shown.length})`; a.disabled = !shown.length; a._ids = shown.map(p => p.id); }
  if (b) b.textContent = "Hapus semua hari";
}
async function hapusSemuaHari(btn){
  if (!confirm("Hapus SEMUA postingan di SEMUA hari? Tidak bisa dibatalkan.")) return;
  if (!confirm("Yakin? Semua postingan akan hilang permanen.")) return;
  btn.disabled = true; let n = 0;
  try {
    for (;;) {
      const snap = await getDocs(query(collection(db, "posts"), limit(400)));
      if (snap.empty) break;
      const b = writeBatch(db); snap.docs.forEach(d => b.delete(d.ref)); await b.commit();
      n += snap.size; btn.textContent = "Terhapus " + n + "…";
    }
    alert(n + " postingan terhapus.");
  } catch (e) { alert("Gagal hapus: " + e.code); }
  btn.disabled = false; btn.textContent = "Hapus semua hari";
}
async function hapusMassal(ids, label){
  if (!ids.length) return;
  if (!confirm(`${label}: ${ids.length} postingan akan dihapus permanen. Lanjut?`)) return;
  if (ids.length > 20 && !confirm("Yakin? Tidak bisa dibatalkan.")) return;
  try {
    for (let i = 0; i < ids.length; i += 400) {
      const b = writeBatch(db);
      ids.slice(i, i + 400).forEach(id => b.delete(doc(db, "posts", id)));
      await b.commit();
    }
  } catch (e) { alert("Gagal hapus: " + e.code); }
}

function renderWho(){
  if (user) {
    const nama = user.displayName || user.email;
    $("who").innerHTML = `<span class="pill"><span class="av">${esc(nama.charAt(0).toUpperCase())}</span>${esc(nama)}${isAdmin() ? " (admin)" : ""}</span><button class="btn ghost" id="out">Keluar</button>`;
    $("out").onclick = () => signOut(auth);
  } else {
    $("who").innerHTML = `<button class="btn ghost" id="in">Masuk</button>`;
    $("in").onclick = login;
  }
}
async function login(){
  try { await signInWithPopup(auth, new GoogleAuthProvider()); }
  catch (e) { if (e.code !== "auth/popup-closed-by-user" && e.code !== "auth/cancelled-popup-request") alert("Gagal masuk: " + e.code); }
}

function render(){
  const id = decodeURIComponent(location.hash.slice(1));
  const main = $("app");
  if (loadErr) { main.innerHTML = `<p class="err">${esc(loadErr)}</p>`; return; }
  if (!loaded) { main.innerHTML = `<p class="empty">Memuat…</p>`; return; }

  if (id) {
    let p = posts.find(x => x.id === id);
    if (!p && extra && extra.id === id) p = extra;
    if (!p && extraTry !== id) {
      extraTry = id;
      getDoc(doc(db, "posts", id)).then(s => { if (s.exists()) extra = { id: s.id, ...s.data() }; render(); }).catch(() => render());
      main.innerHTML = `<p class="empty">Memuat…</p>`; return;
    }
    if (!p) { main.innerHTML = `<a class="back" href="#">‹ Semua tulisan</a><p class="empty">Postingan tidak ditemukan atau sudah dihapus.</p>`; return; }
    document.title = p.judul + " · WB.PREDICTION";
    main.innerHTML = `<a class="back" href="#">‹ Semua tulisan</a><div class="card read"><span class="meta">${esc(p.nama)} · ${tgl(p.createdAt)}</span><h2>${esc(p.judul)}</h2>${gbrSrc(p) ? `<img class="gb" alt="${esc(p.judul)}" src="${gbrSrc(p)}">` : ""}${norm(p.isi).split(/\n+/).filter(Boolean).map(baris).join("")}</div><div class="share"><button class="btn" id="sh-c">📋 Salin</button><a class="btn ghost" id="sh-w" target="_blank" rel="noopener">WhatsApp</a><a class="btn ghost" id="sh-t" target="_blank" rel="noopener">Telegram</a><a class="btn ghost" id="sh-f" target="_blank" rel="noopener">Facebook</a><button class="btn ghost" id="sh-x" style="display:none">Lainnya</button></div>${canDelete(p) ? `<button class="btn del" id="del">Hapus postingan</button>` : ""}<section class="cmt"><h3>Komentar</h3><div id="cml"></div><div class="cmf" id="cmf"></div></section>`;
    const d = $("del");
    if (d) d.onclick = async () => {
      if (!confirm("Hapus postingan ini?")) return;
      d.disabled = true;
      try { await deleteDoc(doc(db, "posts", p.id)); location.hash = ""; }
      catch (e) { alert("Gagal hapus: " + e.code); d.disabled = false; }
    };
    const st = shareText(p), pu = location.origin + location.pathname + "#" + encodeURIComponent(p.id), enc = encodeURIComponent;
    $("sh-c").onclick = async () => {
      try { await navigator.clipboard.writeText(st); } catch (e) { prompt("Salin teks ini:", st); }
      const b = $("sh-c"); b.textContent = "✅ Tersalin"; setTimeout(() => { b.textContent = "📋 Salin"; }, 1600);
    };
    $("sh-w").href = "https://wa.me/?text=" + enc(st);
    $("sh-t").href = "https://t.me/share/url?url=" + enc(pu) + "&text=" + enc(st);
    $("sh-f").href = "https://www.facebook.com/sharer/sharer.php?u=" + enc(SITE_LINK) + "&quote=" + enc(st);
    if (navigator.share) { const x = $("sh-x"); x.style.display = ""; x.onclick = () => navigator.share({ title: p.judul, text: st }).catch(() => {}); }
    const cf = $("cmf");
    cf.innerHTML = user
      ? `<textarea id="ci" maxlength="500" placeholder="Tulis komentar…"></textarea><button class="btn" id="ck">Kirim komentar</button>`
      : `<p class="cmnote">Mau komentar? <button class="btn" id="in3">Masuk dengan Google</button></p>`;
    const i3 = $("in3"); if (i3) i3.onclick = login;
    const ck = $("ck");
    if (ck) ck.onclick = async () => {
      const t = $("ci").value.trim(); if (!t) return;
      ck.disabled = true;
      try { await addDoc(collection(db, "posts", p.id, "comments"), { isi: t, uid: user.uid, nama: user.displayName || "Anonim", createdAt: serverTimestamp() }); $("ci").value = ""; }
      catch (e) { alert("Gagal kirim komentar: " + e.code); }
      ck.disabled = false;
    };
    $("cml").onclick = async e => {
      const b = e.target.closest("button[data-c]"); if (!b || !confirm("Hapus komentar ini?")) return;
      b.disabled = true;
      try { await deleteDoc(doc(db, "posts", p.id, "comments", b.dataset.c)); }
      catch (err) { alert("Gagal hapus: " + err.code); b.disabled = false; }
    };
    startCm(p.id);
    window.scrollTo(0, 0);
    return;
  }

  stopCm();
  document.title = "💫WB.PREDICTION💫";
  const composer = isAdmin()
    ? `<details class="compose" id="cmp"><summary>Tulis postingan</summary><form id="f"><label for="j">Judul</label><input id="j" maxlength="120" required><label for="i">Isi</label><textarea id="i" maxlength="5000" required></textarea><button class="btn" id="kirim">Kirim</button></form></details>`
    : user ? "" : `<p class="note">Masuk untuk berkomentar: <button class="btn" id="in2">Masuk dengan Google</button></p>`;
  const chip = (v, t) => `<button class="chip${String(fDay) === String(v) ? " on" : ""}" data-d="${v}">${t}</button>`;
  const bar = `<div class="bar"><input type="search" id="cari" placeholder="Cari pasaran…" value="${esc(fQ)}"><div class="chips">${[0,1,2,3,4,5,6].map(o => { const d = new Date(); d.setDate(d.getDate() - o); return chip(o, o === 0 ? "Hari ini" : o === 1 ? "Kemarin" : HARI[d.getDay()] + " " + d.getDate()); }).join("")}</div>${isAdmin() ? `<div class="adm"><button class="btn del" id="hps">Hapus yang tampil</button><button class="btn del" id="hpa">Hapus semua</button></div>` : ""}</div>`;
  main.innerHTML = composer + bar + `<div id="plist"></div>`;
  $("cari").oninput = e => { fQ = e.target.value.trim().toLowerCase(); renderList(); };
  main.querySelectorAll(".chip").forEach(c => c.onclick = () => {
    fDay = Number(c.dataset.d);
    main.querySelectorAll(".chip").forEach(x => x.classList.toggle("on", x === c)); watchDay(fDay);
  });
  const hs = $("hps"), ha = $("hpa");
  if (hs) hs.onclick = () => hapusMassal(hs._ids || [], "Hapus yang tampil");
  if (ha) ha.onclick = () => hapusSemuaHari(ha);
  renderList();

  const f = $("f");
  if (f) f.onsubmit = async e => {
    e.preventDefault();
    const b = $("kirim"); b.disabled = true;
    try {
      await addDoc(collection(db, "posts"), { judul: $("j").value.trim(), isi: $("i").value.trim(), uid: user.uid, nama: user.displayName || "Anonim", createdAt: serverTimestamp() });
      f.reset(); $("cmp").open = false;
    } catch (err) { alert("Gagal kirim: " + err.code); }
    b.disabled = false;
  };
  const i2 = $("in2"); if (i2) i2.onclick = login;
}

onAuthStateChanged(auth, u => { user = u; renderWho(); render(); });
window.addEventListener("hashchange", render);
renderWho();
render();
watchDay(fDay);
</script>
</body>
</html>

<style>
/* ===== tampilan forum (versi baru): hitam + bingkai emas + bar hijau ===== */
:root{color-scheme:dark;--bg:#232323;--ink:#fff;--mute:#9fb8a4;--line:#eca808;--acc:#f4f11a;--accink:#000;--card:#000;--bad:#ff7b7b;--gr:#19ff19;--top:#19511e;--bar:#006600}
*{box-sizing:border-box}
html{background:#232323}
body{margin:0 auto;max-width:760px;padding:0 0 56px;color:var(--ink);font:15px/1.6 Arial,"Roboto Condensed",system-ui,sans-serif;background:#000;box-shadow:0 0 8px #000;min-height:100vh}
a{color:var(--acc)}
a:hover{color:#fff}
button{font:inherit;cursor:pointer}
main{padding:10px 10px 0}
.top{text-align:center;margin:0 0 10px;background:var(--top);padding:14px 12px 0;border-bottom:2px solid #000}
.top a.home{text-decoration:none;color:#fff;display:block}
h1.brand{font:800 clamp(20px,6vw,30px)/1.2 "Roboto Condensed",Arial,sans-serif;margin:0;letter-spacing:.04em;text-shadow:1px 1px 2px #000}
.tag{margin:6px 0 0;line-height:1.4}
.tag b{display:block;font:700 14px/1.4 Arial,sans-serif;color:var(--acc)}
